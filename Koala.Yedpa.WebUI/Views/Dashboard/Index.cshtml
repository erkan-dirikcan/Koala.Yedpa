@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
}

<div class="d-flex flex-column-fluid">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10 text-center" style="padding-top:6rem">

                <img src="https://illustrations.popsy.co/amber/crashed-error.svg"
                     alt="Under Construction"
                     style="max-width:420px;width:100%;margin-bottom:2rem" />

                <h2 class="fw-bolder text-dark mb-4" style="font-size:1.8rem">
                    Dashboard Hazırlanıyor
                </h2>

                <p class="text-muted fs-5 mb-6" style="max-width:500px;margin:0 auto">
                    Yeni dashboard özelleştirilebilir widget'lar, grafikler ve sürükle-bırak özelliği ile çok yakında burada.
                </p>

                <div class="d-flex justify-content-center gap-4 mt-8">
                    <div class="text-center">
                        <span class="svg-icon svg-icon-4x svg-icon-primary">
                            <i class="fas fa-chart-bar text-primary" style="font-size:2.5rem"></i>
                        </span>
                        <p class="text-muted mt-2 fs-7">Grafikler</p>
                    </div>
                    <div class="text-center">Ek bütçe oluşturmak istediğim
                        <span class="svg-icon svg-icon-4x svg-icon-success">
                            <i class="fas fa-th-large text-success" style="font-size:2.5rem"></i>
                        </span>
                        <p class="text-muted mt-2 fs-7">Widget'lar</p>
                    </div>
                    <div class="text-center">
                        <span class="svg-icon svg-icon-4x svg-icon-warning">
                            <i class="fas fa-arrows-alt text-warning" style="font-size:2.5rem"></i>
                        </span>
                        <p class="text-muted mt-2 fs-7">Sürükle & Bırak</p>
                    </div>
                    <div class="text-center">
                        <span class="svg-icon svg-icon-4x svg-icon-danger">
                            <i class="fas fa-user-cog text-danger" style="font-size:2.5rem"></i>
                        </span>
                        <p class="text-muted mt-2 fs-7">Kişiselleştirme</p>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
