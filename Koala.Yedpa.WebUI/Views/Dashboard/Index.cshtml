@using Koala.Yedpa.WebUI.Controllers
@using Koala.Yedpa.Core.Models.ViewModels
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
    var widgets = ViewBag.Widgets as List<DashboardWidgetViewModel> ?? new List<DashboardWidgetViewModel>();
    var hiddenWidgets = ViewBag.HiddenWidgets as List<DashboardWidgetViewModel> ?? new List<DashboardWidgetViewModel>();
    var allWidgets = widgets.Concat(hiddenWidgets).ToList();

    var totalDebit = ViewBag.TotalDebit as decimal? ?? 0;
    var totalCredit = ViewBag.TotalCredit as decimal? ?? 0;
    var netBalance = ViewBag.NetBalance as decimal? ?? 0;
    var topDebtors = ViewBag.TopDebtors as List<CustomerListWithBalanceViewModel> ?? new List<CustomerListWithBalanceViewModel>();
    var pendingInvoices = ViewBag.PendingInvoices as List<PendingInvoiceViewModel> ?? new List<PendingInvoiceViewModel>();
    var pendingTotal = ViewBag.PendingTotal as decimal? ?? 0;
    var overdueInvoices = ViewBag.OverdueInvoices as List<PendingInvoiceViewModel> ?? new List<PendingInvoiceViewModel>();
    var overdueTotal = ViewBag.OverdueTotal as decimal? ?? 0;
    var shopCount = ViewBag.ShopCount as int? ?? 0;
    var monthlyBudget = ViewBag.MonthlyBudget as MonthlyBudgetSummaryViewModel;
    var budgetTotalBudget = ViewBag.BudgetTotalBudget as decimal? ?? 0;
    var budgetCollected = ViewBag.BudgetCollected as decimal? ?? 0;
    var budgetRemaining = ViewBag.BudgetRemaining as decimal? ?? 0;
    var yearlyBudgetData = ViewBag.YearlyBudgetData as List<YearlyBudgetItem> ?? new List<YearlyBudgetItem>();
}

<link href="~/css/dashboard/dashboard.css" rel="stylesheet" />
<div class="d-flex flex-column-fluid">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12">

                <!-- Bulk Invoicing Alert Banner -->
                <div id="bulkInvoiceAlert" class="alert alert-custom alert-light-primary fade show mb-6 d-none" role="alert">
                    <div class="alert-icon">
                        <i class="fas fa-file-invoice-dollar text-primary"></i>
                    </div>
                    <div class="alert-text">
                        <h4 class="alert-heading">Toplu Faturalandırma Hazır!</h4>
                        <p>Bu ay için faturalandırılmamış aidat siparişleri bulunuyor. Toplu faturalandırma işlemi başlatmak için <strong><a href="#" id="openBulkInvoiceModal" style="text-decoration: underline;">buraya tıklayın</a></strong>.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>

                <div class="card card-custom">
                    <div class="card-header flex-wrap border-0 pt-6 pb-0">
                        <div class="card-title">
                            <h3 class="card-label">
                                DashBoard
                                <span class="d-block text-muted pt-2 font-size-sm">Bütçe ve Sipariş Oluşturma</span>
                            </h3>
                        </div>


                        <div class="card-toolbar">
                            @if (Context.Request.Host.Value.Contains("localhost"))
                            {
                                <button type="button" class="btn btn-sm btn-light-warning me-2" id="btnTestBulkInvoice" title="Toplu Fatura Test">
                                    <i class="fas fa-vial mr-1"></i> Toplu Fatura Test
                                </button>
                            }
                            <button type="button" class="btn btn-sm btn-light-primary" id="btnToggleSidebar">
                                <i class="fas fa-th-large mr-1"></i> Widgetlar
                            </button>
                            <button type="button" class="btn btn-sm btn-light-danger" id="btnResetLayout">
                                <i class="fas fa-undo mr-1"></i> Sıfırla
                            </button>
                        </div>

                        <div class="card-body">
                            <div class="row" id="dashboardWidgets">
                                @foreach (var widget in widgets)
                                {
                                    var colClass = widget.Width switch { 12 => "col-12", 4 => "col-lg-4 col-md-6", 3 => "col-lg-3 col-md-6", _ => "col-lg-6 col-md-12" };
                                    <div class="widget-wrapper @colClass mb-6" data-widget-id="@widget.Id" data-width="@widget.Width">
                                        <div class="card card-xl-stretch mb-5 mb-xl-8">
                                            <div class="card-header border-0 pt-5">
                                                <h3 class="card-title align-items-start flex-column">
                                                    <span class="card-label fw-bolder fs-3 mb-1">@widget.Title</span>
                                                </h3>
                                                <div class="card-toolbar">
                                                    <span class="drag-handle" title="Sürükleerek sıralayın">
                                                        <i class="fas fa-grip-vertical text-muted"></i>
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="card-body py-3">
                                                @switch (widget.Id)
                                                {
                                                    case "W1":
                                                        <div class="kpi-row">
                                                            <div class="kpi-item kpi-danger">
                                                                <div class="kpi-value">@totalDebit.ToString("N2") ₺</div>
                                                                <div class="kpi-label">Toplam Alacak</div>
                                                            </div>
                                                            <div class="kpi-item kpi-success">
                                                                <div class="kpi-value">@totalCredit.ToString("N2") ₺</div>
                                                                <div class="kpi-label">Toplam Borç</div>
                                                            </div>
                                                            <div class="kpi-item kpi-primary">
                                                                <div class="kpi-value">@netBalance.ToString("N2") ₺</div>
                                                                <div class="kpi-label">Net Bakiye</div>
                                                            </div>
                                                        </div>
                                                        break;

                                                    case "W2":
                                                        <div class="kpi-item kpi-danger mb-3" style="border-radius:0.5rem;padding:0.75rem">
                                                            <div class="kpi-value">@pendingTotal.ToString("N2") ₺</div>
                                                            <div class="kpi-label">Toplam Bekleyen</div>
                                                        </div>
                                                        @if (pendingInvoices.Any())
                                                        {
                                                            <table class="widget-table">
                                                                <thead><tr><th>Fatura</th><th>Cari</th><th>Tutar</th><th>Vade</th></tr></thead>
                                                                <tbody>
                                                                    @foreach (var inv in pendingInvoices)
                                                                    {
                                                                        var rowStyle = inv.RemainingDays < 0 ? "color:#F64E60" : "";
                                                                        <tr style="@rowStyle">
                                                                            <td>@inv.InvoiceNumber</td>
                                                                            <td>@(inv.CustomerName?.Length > 20 ? inv.CustomerName.Substring(0, 20) : inv.CustomerName)</td>
                                                                            <td>@inv.RemainingAmount.ToString("N2") ₺</td>
                                                                            <td>@inv.DueDate.ToString("dd.MM.yyyy")</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                        else
                                                        {
                                                            <div class="widget-loading">Bekleyen fatura bulunamadı</div>
                                                        }
                                                        break;

                                                    case "W3":
                                                        <div class="kpi-item kpi-danger mb-3" style="border-radius:0.5rem;padding:0.75rem">
                                                            <div class="kpi-value">@overdueTotal.ToString("N2") ₺</div>
                                                            <div class="kpi-label">Vadesi Geçen Toplam (@overdueInvoices.Count fatura)</div>
                                                        </div>
                                                        @if (overdueInvoices.Any())
                                                        {
                                                            <table class="widget-table">
                                                                <thead><tr><th>Fatura</th><th>Cari</th><th>Tutar</th><th>Gecikme</th></tr></thead>
                                                                <tbody>
                                                                    @foreach (var inv in overdueInvoices.Take(5))
                                                                    {
                                                                        <tr style="color:#F64E60">
                                                                            <td>@inv.InvoiceNumber</td>
                                                                            <td>@(inv.CustomerName?.Length > 20 ? inv.CustomerName.Substring(0, 20) : inv.CustomerName)</td>
                                                                            <td>@inv.RemainingAmount.ToString("N2") ₺</td>
                                                                            <td>@Math.Abs(inv.RemainingDays) gün</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                        break;

                                                    case "W4":
                                                        <div style="height:280px">
                                                            <canvas id="chartBalanceDist"></canvas>
                                                        </div>
                                                        break;

                                                    case "W5":
                                                        <div style="height:280px">
                                                            <canvas id="chartMonthlyTrend"></canvas>
                                                        </div>
                                                        break;

                                                    case "W6":
                                                        <div style="text-align:center;padding:2rem;color:#B5B5C3">
                                                            <i class="fas fa-list fa-2x mb-2"></i>
                                                            <p>Son işlemler için veri hazırlanıyor</p>
                                                        </div>
                                                        break;

                                                    case "W7":
                                                        <div style="height:280px">
                                                            <canvas id="chartDues"></canvas>
                                                        </div>
                                                        break;

                                                    case "W8":
                                                        <div class="kpi-row">
                                                            <div class="kpi-item kpi-primary">
                                                                <div class="kpi-value">@budgetTotalBudget.ToString("N2") ₺</div>
                                                                <div class="kpi-label">Toplam Bütçe</div>
                                                            </div>
                                                            <div class="kpi-item kpi-success">
                                                                <div class="kpi-value">@budgetCollected.ToString("N2") ₺</div>
                                                                <div class="kpi-label">Tahsil Edilen</div>
                                                            </div>
                                                            <div class="kpi-item kpi-danger">
                                                                <div class="kpi-value">@budgetRemaining.ToString("N2") ₺</div>
                                                                <div class="kpi-label">Kalan</div>
                                                            </div>
                                                        </div>
                                                        break;

                                                    case "W9":
                                                        <div style="height:300px">
                                                            <canvas id="chartYearlyBudget"></canvas>
                                                        </div>
                                                        break;

                                                    case "W10":
                                                        <div style="display:flex;align-items:center;justify-content:center;min-height:120px">
                                                            <div class="kpi-item kpi-primary" style="min-width:200px">
                                                                <div class="kpi-value" style="font-size:2.5rem">@shopCount</div>
                                                                <div class="kpi-label">Aktif Dükkan</div>
                                                            </div>
                                                        </div>
                                                        break;
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Widget Sidebar -->
                            <div class="widget-sidebar" id="widgetSidebar">
                                <div class="sidebar-header">
                                    <span class="sidebar-title">Widget Yönetimi</span>
                                    <button type="button" class="btn btn-icon btn-sm btn-light btn-circle" id="btnCloseSidebar">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                                @foreach (var widget in allWidgets)
                                {
                                    var currentWidth = widget.Width > 0 ? widget.Width : 6;
                                    <div class="widget-toggle-item">
                                        <span>@widget.Title</span>
                                        <div class="d-flex align-items-center gap-3">
                                            <select class="form-control form-control-sm widget-width-select" data-widget-id="@widget.Id" style="width:80px">
                                                @if (currentWidth == 12) { <text><option value="12" selected>Tam</option></text> } else { <text><option value="12">Tam</option></text> }
                                                @if (currentWidth == 6) { <text><option value="6" selected>Yarım</option></text> } else { <text><option value="6">Yarım</option></text> }
                                                @if (currentWidth == 4) { <text><option value="4" selected>1/3</option></text> } else { <text><option value="4">1/3</option></text> }
                                                @if (currentWidth == 3) { <text><option value="3" selected>1/4</option></text> } else { <text><option value="3">1/4</option></text> }
                                            </select>
                                            <div class="switch switch-sm">
                                                <label>
                                                    <input type="checkbox" class="widget-toggle" data-widget-id="@widget.Id" @(widget.Visible ? "checked" : "") />
                                                    <span></span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                }
                                <div style="margin-top:1.5rem">
                                    <button type="button" class="btn btn-primary btn-sm w-100" id="btnSaveWidgets">
                                        <i class="fas fa-save mr-1"></i> Kaydet
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Bulk Invoicing Modal -->
<div class="modal fade" id="bulkInvoiceModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-file-invoice-dollar text-primary me-2"></i>
                    Toplu Faturalandırma
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Tarih Seçici -->
                <div class="row mb-6">
                    <div class="col-md-4">
                        <label class="form-label required">Fatura Tarihi</label>
                        <input type="text" class="form-control" id="invoiceDate" placeholder="dd.MM.yyyy" />
                        <span class="form-text text-muted">Bu tarih hem fatura tarihi hem vade tarihi olarak kullanılacaktır.</span>
                    </div>
                </div>

                <!-- DataTable -->
                <div class="table-responsive">
                    <table class="table table-bordered table-hover" id="pendingLinesTable" style="margin-top: 13px !important">
                        <thead>
                            <tr>
                                <th style="width: 40px;" class="text-center">
                                    <div class="form-check form-check-sm form-check-custom form-check-solid">
                                        <input class="form-check-input" type="checkbox" id="selectAllLines" />
                                    </div>
                                </th>
                                <th>Cari Kod</th>
                                <th>Cari Adı</th>
                                <th class="text-end">Tutar</th>
                                <th>Ay Adı</th>
                                <th class="text-center">Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Veriler AJAX ile doldurulacak -->
                        </tbody>
                    </table>
                </div>

                <!-- Toplam Tut ve Butonlar -->
                <div class="d-flex justify-content-between align-items-center mt-6">
                    <div>
                        <span class="fw-bolder fs-5">Seçilen Toplam: </span>
                        <span class="fw-bolder fs-4 text-primary" id="selectedTotal">0.00 ₺</span>
                    </div>
                    <div class="d-flex gap-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="button" class="btn btn-primary" id="btnCreateInvoices" disabled>
                            <i class="fas fa-file-invoice me-2"></i>Faturalandır
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        window.__dashboardData = {
            topDebtors: @Html.Raw(Json.Serialize(topDebtors.Select(c => new { Name = c.Definition?.Length > 15 ? c.Definition.Substring(0, 15) : c.Definition ?? c.Code, Balance = c.Balance }))),
            budgetCollected: @Html.Raw(Json.Serialize(budgetCollected)),
            budgetRemaining: @Html.Raw(Json.Serialize(budgetRemaining)),
            monthlyData: @Html.Raw(Json.Serialize(monthlyBudget?.MonthlyData?.Select(m => (double)m.NewBudget) ?? new List<double>())),
            yearlyBudgetData: @Html.Raw(Json.Serialize(yearlyBudgetData.Select(y => new { Year = y.Year.ToString(), Budget = (double)y.Budget, Collected = (double)y.Collected }))),
            visibleWidgets: @Html.Raw(Json.Serialize(widgets.Select(w => w.Id).ToList()))
        };
    </script>
    <script src="~/js/dashboard/dashboard.js"></script>
    <script src="~/js/dashboard/bulk-invoice.js"></script>
}
