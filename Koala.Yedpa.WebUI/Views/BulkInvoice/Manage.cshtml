@{
    ViewData["Title"] = "Toplu Faturalandırma Yönetimi";
    ViewData["ActivePage"] = "BulkInvoiceManage";
}

<div class="d-flex flex-column-fluid">
    <div class="container-fluid">

        <!-- Oturumlar -->
        <div class="card card-custom mb-6">
            <div class="card-header border-0 pt-6">
                <div class="card-title">
                    <h3 class="card-label">Toplu Faturalandırma Oturumları
                        <span class="d-block text-muted pt-2 font-size-sm">Aktarım oturumları ve sonuçları</span>
                    </h3>
                </div>
                <div class="card-toolbar">
                    <button type="button" class="btn btn-sm btn-light-primary" id="btnRefreshSessions">
                        <i class="fas fa-sync"></i> Yenile
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover" id="sessionsTable" style="width:100%">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Aktarım Tarihi</th>
                                <th>Durum</th>
                                <th class="text-right">Toplam</th>
                                <th class="text-right">Aktarılan</th>
                                <th class="text-right">Başarısız</th>
                                <th>Oluşturan</th>
                                <th>Oluşturma</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Satırlar -->
        <div class="card card-custom" id="itemsCard" style="display:none">
            <div class="card-header border-0 pt-6">
                <div class="card-title">
                    <h3 class="card-label">Aktarım Yapılacak Firmalar
                        <span class="d-block text-muted pt-2 font-size-sm" id="itemsSubtitle"></span>
                    </h3>
                </div>
                <div class="card-toolbar">
                    @* Excel / Yazdır butonları DataTables Buttons tarafından buraya basılır. *@
                    <div id="itemsExportButtons" class="d-inline-block mr-2"></div>
                    <button type="button" class="btn btn-sm btn-light-success mr-2" id="btnPrepareItems">
                        <i class="fas fa-sync-alt"></i> Listeyi Güncelle
                    </button>
                    <button type="button" class="btn btn-sm btn-light-danger" id="btnRetryFailed">
                        <i class="fas fa-redo"></i> Eksik Kalanları Yeniden Aktar
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover" id="itemsTable" style="width:100%">
                        <thead>
                            <tr>
                                <th>Cari Kod</th>
                                <th>Cari Ad</th>
                                <th>Ay</th>
                                <th class="text-right">Tutar</th>
                                <th class="text-center">Durum</th>
                                <th class="text-center">Deneme</th>
                                <th>Fiş Ref</th>
                                <th>Not</th>
                                <th>REST Hata</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{ var deepLinkSessionId = ViewBag.SessionId as int?; }
    <script>
        // Dashboard'daki "Aktarım Yapılacak Firmaları Görüntüle" butonundan gelen oturum.
        window.__bulkInvoiceSessionId = @(deepLinkSessionId?.ToString() ?? "null");
    </script>
    <script src="~/assets/js/custom/bulk-invoice-manage-page.js"></script>
}
